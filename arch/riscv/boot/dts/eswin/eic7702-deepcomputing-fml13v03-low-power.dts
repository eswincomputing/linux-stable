&d0_i2c0 {
	status = "okay";

	/* codec es8326 */
	d0_es8326_0: es8326@19 {
		#sound-dai-cells = <0>;
		compatible = "everest,es8326";
		reg = <0x19>;
		status = "okay";

		clocks = <&d0_clock EIC7700_CLK_VO_I2S_MCLK>;
		clock-names = "mclk";

		interrupt-parent = <&porta>;
		interrupts = <28 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_die0_gpio28_default
					 &pinctrl_die0_gpio111_default>;

		spk-ctl-gpio = <&portd 15 GPIO_ACTIVE_HIGH>;

//		everest,jack-detect-inverted;
		everest,jack-pol = [0e];
		everest,mic1-src = [00];
		everest,mic2-src = [44];
		everest,interrupt-src = [08];
		everest,interrupt-clk = [45];

		port {
			es8326_endpoint: endpoint {
				system-clock-frequency = <12288000>;
				remote-endpoint = <&d0_i2s1_endpoint>;
			};
		};
	};
};

&d1_i2c0 {
	status = "disabled";
};

&d0_i2c1 {
	status = "okay";
	tps549d22@10 {
		status = "okay";
		compatible = "ti,tps549d22";
		reg = <0x10>;
		eswin,regulator_default-microvolt=<700000>;
		label = "npu_vdd";
		regulators {
			d0_npu_vcc: npu_svcc {
				regulator-name = "NPU_SVCC";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1120000>;
				regulator-min-microamp = <20000000>;
				regulator-max-microamp = <40000000>;
				regulator-ov-protection-microvolt = <1100000>;
			};
		};
	};
};

&d1_i2c1 {
	status = "okay";
	tps549d22@10 {
		compatible = "ti,tps549d22";
		reg = <0x10>;
		eswin,regulator_default-microvolt=<700000>;
		label = "d1_npu_vdd";
		regulators {
			d1_npu_vcc: npu_svcc {
				regulator-name = "NPU_SVCC2";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1120000>;
				regulator-min-microamp = <20000000>;
				regulator-max-microamp = <40000000>;
				regulator-ov-protection-microvolt = <1100000>;
			};
		};
	};
};

&d0_i2c2 {
	status = "ok";

	d0_touchpad: hid@2c {
		/* touch pad*/
		compatible = "hid-over-i2c";
		reg = <0x2c>;
		hid-descr-addr = <0x0020>;
		post-power-on-delay-ms = <200>;
		interrupt-parent = <&porta>;
		interrupts = <20 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_die0_gpio20_default>;
		irq-gpios = <&porta 20 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	cm32181_sensor: cm32181@10 {
		compatible = "capella,cm32181";
		reg = <0x10>;
		status = "okay";
	};

	cm32183_sensor: cm32183@29 {
		compatible = "capella,cm32183";
		reg = <0x29>;
		status = "okay";
	};
};

&d1_i2c2 {
	/* touch screen*/
	status = "disabled";
	d1_gt911:touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		interrupt-parent = <&d1_porta>;
		interrupts = <0 IRQ_TYPE_EDGE_RISING>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_die1_gpio0_default>;
		irq-gpios = <&d1_porta 0 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&d1_portd 15 GPIO_ACTIVE_HIGH>;
	};
};

