&d0_aon_i2c0 {
	/* ina226x3 */
	status = "okay";
	i2c-sda-hold-time-ns = <0x40>;
	ina226@40 {
		compatible = "ti,ina226";
		#io-channel-cells = <1>;
		label = "cpu_vdd";
		reg = <0x40>;
		shunt-resistor = <1000>;
	};
	ina226@41 {
		compatible = "ti,ina226";
		#io-channel-cells = <1>;
		label = "d0_lpddr_vdd";
		reg = <0x41>;
		shunt-resistor = <1000>;
	};
	ina226@44 {
		compatible = "ti,ina226";
		#io-channel-cells = <1>;
		label = "d0_soc_vdd";
		reg = <0x44>;
		shunt-resistor = <1000>;
	};
	tmp102@48 {
		compatible = "ti,tmp102";
		reg = <0x48>;
		label = "d0_board_tmp";
		#thermal-sensor-cells = <1>;
	};
};


&d1_aon_i2c0 {
	/* ina226x4 */
	status = "okay";
	i2c-sda-hold-time-ns = <0x40>;
	ina226@40 {
			compatible = "ti,ina226";
			#io-channel-cells = <1>;
			label = "vdd_dc_in";
			reg = <0x40>;
			shunt-resistor = <1000>;
