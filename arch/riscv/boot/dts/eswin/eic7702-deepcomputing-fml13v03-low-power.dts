&d1_ssi0 {
	/* spi flash */
	status = "okay";
	num-cs = <2>;
	spi-flash@0 {
		compatible = "winbond,w25q128fw",
					"jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <4800000>;
		rx-sample-delay-ns = <10>;
	};
	spi-flash@1 {
		compatible = "winbond,w25q128fw",
					"jedec,spi-nor";
		reg = <1>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <4800000>;
		rx-sample-delay-ns = <10>;
	};
};

&pinctrl_die0_spi2_default {
	mux1 {
		groups = "spi2_clk_group";
		function = "spi2_clk_func";
	};
	conf1 {
		groups = "spi2_clk_group";
		input-enable = <1>;
		bias-pull-up = <1>;
		bias-pull-down = <0>;
	};
	mux2 {
		groups = "spi2_d0_group";
		function = "spi2_d0_func";
	};
	conf2 {
		groups = "spi2_d0_group";
		input-enable = <1>;
		bias-pull-up = <1>;
		bias-pull-down = <0>;
	};
	mux3 {
		groups = "spi2_d1_d2_d3_group";
		function = "spi2_d1_d2_d3_func";
	};
	conf3 {
		groups = "spi2_d1_d2_d3_group";
		input-enable = <1>;
		bias-pull-up = <1>;
		bias-pull-down = <0>;
	};
};

&pinctrl_die0_gpio6_default {
	mux {
		groups = "gpio6_group";
		function = "gpio6_func";
	};
	conf {
		groups = "gpio6_group";
		drive-strength = <2>;
		bias-pull-up = <1>;
		bias-pull-down = <0>;
	};
};

&ssi1 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_die0_spi2_default
				 &pinctrl_die0_gpio6_default>;	// SPI pin multiplexing

	cs-gpios = <&porta 6 GPIO_ACTIVE_LOW>;
	num-cs = <1>;

	fwos_ec: spi@0 {
		compatible = "google,cros-ec-spi";
		reg = <0>;
		status = "okay";

		spi-max-frequency = <4800000>;			// Maximum SPI clock frequency (4.8 MHz)
		mode = <0>;								// SPI Mode 0 (CPOL=0, CPHA=0)
		rx-sample-delay-ns = <10>;				// Receive sample delay in nanoseconds
		google,cros-ec-spi-pre-delay = <10>;
		google,cros-ec-spi-msg-delay = <10>;

		interrupt-parent = <&porta>;
		interrupts = <25 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_die0_gpio25_default>;
	};
};

&d1_ssi1 {
	/* unused */
	status = "disabled";
};

&bootspi {
	/* spi flash */
	status = "okay";
	num-cs = <1>;
	cs-gpios = <&portd 0 GPIO_ACTIVE_LOW>;
	wp-gpios = <&portd 4 GPIO_ACTIVE_LOW>;
	spi-flash@0 {
		compatible = "winbond,w25q128jw",
					"jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <4800000>;
		rx-sample-delay-ns = <10>;
	};
};

&d1_bootspi {
	/* spi flash */
	status = "disabled";
	num-cs = <1>;
	cs-gpios = <&d1_portd 0 GPIO_ACTIVE_LOW>;
	wp-gpios = <&d1_portd 4 GPIO_ACTIVE_LOW>;
	spi-flash@0 {
		compatible = "winbond,w25q128jw",
					"jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <4800000>;
		rx-sample-delay-ns = <10>;
	};
};

