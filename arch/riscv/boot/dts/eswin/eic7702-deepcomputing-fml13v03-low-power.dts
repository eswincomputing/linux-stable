&dc {
	status = "okay";
	dc_out: port {
		#address-cells = <1>;
		#size-cells = <0>;
		dc_out_hdmi: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&hdmi_in_dc>;
		};
		dc_out_dpi1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&vd_input>;
		};
	};
};

&d1_dc {
	status = "okay";
	d1_dc_out: port {
		#address-cells = <1>;
		#size-cells = <0>;
		d1_dc_out_hdmi: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&d1_hdmi_in_dc>;
		};
		d1_dc_out_dpi1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&d1_vd_input>;
		};
	};
};

