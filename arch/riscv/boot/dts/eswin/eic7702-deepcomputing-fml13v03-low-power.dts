	clock-names = "mclk", "apll";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_die0_i2s1_default>;
	d0_i2s1_port: port {
		d0_i2s1_endpoint: endpoint {
			remote-endpoint = <&es8326_endpoint>;
			dai-format = "i2s";
		};
	};
};

