/dts-v1/;

#include "ebc7702-u01-pcie.dtsi"

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	model = "ESWIN EBC7702-U01 A2";

	/* die0 gpio68 system led */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_die0_gpio68_default>;

		gpio-68 {
			gpios = <&portc 4 GPIO_ACTIVE_LOW>;
			label = "heartbeat";
			linux,default-trigger = "heartbeat";
		};
	};
};

&d0_i2c3 {
	/* SOC2&4 serdes clk, configured by scpu&lpcpu */
	status = "disabled";
	es501x@42 {
		compatible = "einno,es501x";
		reg = <0x42>;
		status = "okay";
		eswin,regulator_default-microvolt=<875000>;
		eswin,regulator_label = "Supply VDD1", "cpu_vdd";
		label = "vdd_cpu";
		regulators {
			vdd_cpu_reg:vdd_cpu{
				regulator-name="vdd_cpu";
				regulator-min-microvolt=<875000>;
				regulator-max-microvolt=<875000>;
				regulator-init-microvolt=<875000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&d0_i2c4 {
	/* SOC1 ADS1115, accessed by lpcpu */
	status = "disabled";
	es501x@40 {
		compatible = "einno,es501x";
		reg = <0x40>;
		status = "okay";
		eswin,regulator_default-microvolt=<800000>;
		eswin,regulator_label = "Supply VDD1", "soc_vdd";
		label = "vdd_soc_lpddr";
		regulators {
			vdd_soc_lpddr_reg:vdd_soc_cpu{
				regulator-name="vdd_soc_lpddr";
				regulator-min-microvolt=<800000>;
				regulator-max-microvolt=<800000>;
				regulator-init-microvolt=<800000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&d0_i2c5 {
	status = "disabled";
	/* SOC1 eeprom, read by lpcpu */
	ina226@44 {
		compatible = "ti,ina226";
		#io-channel-cells = <1>;
		label = "power_vdd";
		reg = <0x44>;
		shunt-resistor = <1000>;
	};
	tmp102@48 {
		compatible = "ti,tmp102";
		reg = <0x48>;
		label = "board_tmp";
		#thermal-sensor-cells = <1>;
	};
};

&d0_i2c11 {
	/* d0 npu pmic */
	status = "okay";
	tps549d22@10 {
		compatible = "ti,tps549d22";
		reg = <0x10>;
		eswin,regulator_default-microvolt=<1000000>;
		eswin,regulator_label = "Supply VDD", "D0 NPU Voltage";
		label = "npu_vdd";
		regulators{
			d0_npu_vcc:npu_svcc{
				regulator-name="D0_NPU_SVCC";
				regulator-min-microvolt=<700000>;
				regulator-max-microvolt=<1100000>;
				regulator-min-microamp=<20000000>;
				regulator-max-microamp=<40000000>;
				regulator-ov-protection-microvolt=<1100000>;
			};
		};
	};
};

&d1_i2c11 {
	/* d1 npu pmic */
	status = "okay";
	tps549d22@10 {
		compatible = "ti,tps549d22";
		reg = <0x10>;
		eswin,regulator_default-microvolt=<1000000>;
		eswin,regulator_label = "Supply VDD1", "D1 NPU Voltage";
		label = "d1_npu_vdd";
		regulators{
			d1_npu_vcc:npu_svcc{
				regulator-name="D1_NPU_SVCC";
				regulator-min-microvolt=<700000>;
				regulator-max-microvolt=<1100000>;
				regulator-min-microamp=<20000000>;
				regulator-max-microamp=<40000000>;
				regulator-ov-protection-microvolt=<1100000>;
			};
		};
	};
};

&d1_pwm0 {
	status = "okay";
};

&fan_control {
	label = "auxiliary_fan";
};

&d1_fan_control {
	label = "thermal_fan";
	status = "okay";
};
