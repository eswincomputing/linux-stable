/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target = <&mipidphy0_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx415_out0>;
			data-lanes = <1 2 3 4>;
		};
	};

	fragment@1 {
		target = <&mipidphy2_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx415_out1>;
			data-lanes = <1 2 3 4>;
		};
	};

	fragment@2 {
		target = <&mipidphy4_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx415_out2>;
			data-lanes = <1 2 3 4>;
		};
	};

	fragment@3 {
		target = <&csi2_dphy0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@4 {
		target = <&csi2_dphy2>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@5 {
		target = <&csi2_dphy4>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@6 {
		target = <&d0_i2c3>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx415_0:imx415_0@37 {
				compatible = "sony,imx415";
				reg = <0x37>;
				clock-names="inck";
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <37125000>;
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio71_default>;
				reset-gpio = <&portc 7 0>;
				eswin,camera-hdr-mode = <0>;
				power-domains = <&d0_pmu 2>;
				status = "okay";
				port {
					imx415_out0: endpoint {
						remote-endpoint = <&mipidphy0_in_ucam0>;
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <742500000>;
					};
				};
			};
		};
	};

	fragment@7 {
		target = <&d0_i2c4>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx415_1:imx415_1@37 {
				compatible = "sony,imx415";
				reg = <0x37>;
				clock-names="inck";
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <37125000>;
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio77_default>;
				reset-gpio = <&portc 13 0>;
				eswin,camera-hdr-mode = <0>;
				power-domains = <&d0_pmu 2>;
				status = "okay";
				port {
					imx415_out1: endpoint {
						remote-endpoint = <&mipidphy2_in_ucam0>;
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <742500000>;
					};
				};
			};
		};
	};

	fragment@8 {
		target = <&d0_i2c5>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx415_2:imx415_2@37 {
				compatible = "sony,imx415";
				reg = <0x37>;
				clock-names="inck";
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <37125000>;
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio83_default>;
				reset-gpio = <&portc 19 0>;
				eswin,camera-hdr-mode = <0>;
				power-domains = <&d0_pmu 2>;
				status = "okay";
				port {
					imx415_out2: endpoint {
						remote-endpoint = <&mipidphy4_in_ucam0>;
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <742500000>;
					};
				};
			};
		};
	};

	fragment@9 {
		target = <&mipi_csi2_0>;
		__overlay__ {
			num_lanes = <4>;
			eswin,csi-hdr-mode = <0>;
		};
	};

	fragment@10 {
		target = <&mipi_csi2_2>;
		__overlay__ {
			num_lanes = <4>;
			eswin,csi-hdr-mode = <0>;
		};
	};

	fragment@11 {
		target = <&mipi_csi2_4>;
		__overlay__ {
			num_lanes = <4>;
			eswin,csi-hdr-mode = <0>;
		};
	};

	fragment@12 {
		target = <&dvp2axi_mipi_lvds0>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@13 {
		target = <&dvp2axi_mipi_lvds1>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@14 {
		target = <&dvp2axi_mipi_lvds2>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@15 {
		target = <&dvp2axi_mipi_lvds3>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@16 {
		target = <&dvp2axi_mipi_lvds4>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@17 {
		target = <&dvp2axi_mipi_lvds5>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@18 {
		target = <&imx219_0>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@19 {
		target = <&imx219_1>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@20 {
		target = <&imx219_2>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@21 {
		target = <&csi2_dphy_hw0>;
		__overlay__ {
			lanes = <1 2 3 4>;
			lanes-dp-dn = <0 0 0 0>;
		};
	};

	fragment@22 {
		target = <&csi2_dphy_hw2>;
		__overlay__ {
			lanes = <1 2 3 4>;
			lanes-dp-dn = <0 0 0 0>;
		};
	};

	fragment@23 {
		target = <&csi2_dphy_hw4>;
		__overlay__ {
			lanes = <1 2 3 4>;
			lanes-dp-dn = <0 0 0 0>;
		};
	};

	fragment@24 {
		target = <&vi_subsys>;
		__overlay__ {
			phy_mode = <2>;
		};
	};
};
