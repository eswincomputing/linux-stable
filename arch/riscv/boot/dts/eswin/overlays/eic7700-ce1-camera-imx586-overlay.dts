/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target = <&mipidphy0_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx586_out0>;
			data-lanes = <1 2 3 4>;
		};
	};

	fragment@1 {
		target = <&mipidphy2_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx586_out1>;
			data-lanes = <1 2 3 4>;
		};
	};

	fragment@2 {
		target = <&mipidphy4_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx586_out2>;
			data-lanes = <1 2 3 4>;
		};
	};

	fragment@3 {
		target = <&csi2_dphy0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@4 {
		target = <&csi2_dphy2>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@5 {
		target = <&csi2_dphy4>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@6 {
		target = <&d0_i2c3>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx586_0:imx586_0@1a {
				compatible = "sony,imx586";
				reg = <0x1a>;
				clock-names="xvclk";
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <24000000>;
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio71_default>;
				reset-gpio = <&portc 7 0>;
				power-domains = <&d0_pmu 2>;
				status = "okay";
				port {
					imx586_out0: endpoint {
						remote-endpoint = <&mipidphy0_in_ucam0>;
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <625000000>;
					};
				};
			};
		};
	};

	fragment@7 {
		target = <&d0_i2c4>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx586_1:imx586_1@1a {
				compatible = "sony,imx586";
				reg = <0x1a>;
				clock-names="xvclk";
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <24000000>;
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio77_default>;
				reset-gpio = <&portc 13 0>;
				power-domains = <&d0_pmu 2>;
				status = "okay";
				port {
					imx586_out1: endpoint {
						remote-endpoint = <&mipidphy2_in_ucam0>;
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <625000000>;
					};
				};
			};
		};
	};

	fragment@8 {
		target = <&d0_i2c5>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx586_2:imx586_2@1a {
				compatible = "sony,imx586";
				reg = <0x1a>;
				clock-names="xvclk";
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <24000000>;
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio83_default>;
				reset-gpio = <&portc 19 0>;
				power-domains = <&d0_pmu 2>;
				status = "okay";
				port {
					imx586_out2: endpoint {
						remote-endpoint = <&mipidphy4_in_ucam0>;
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <625000000>;
					};
				};
			};
		};
	};

	fragment@18 {
		target = <&imx219_0>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@19 {
		target = <&imx219_1>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@20 {
		target = <&imx219_2>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@24 {
		target = <&vi_subsys>;
		__overlay__ {
			phy_mode = <2>;
		};
	};

};
