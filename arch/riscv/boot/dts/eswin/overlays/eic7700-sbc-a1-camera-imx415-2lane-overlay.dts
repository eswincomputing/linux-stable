/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target = <&mipidphy0_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx415_out0>;
			data-lanes = <1 2>;
		};
	};

	fragment@1 {
		target = <&mipidphy2_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx415_out1>;
			data-lanes = <1 2>;
		};
	};

	fragment@2 {
		target = <&csi2_dphy0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@3 {
		target = <&csi2_dphy2>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@4 {
		target = <&d0_i2c3>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx415_0:imx415_0@37 {
				compatible = "sony,imx415";
				reg = <0x37>;
				clock-names="inck";
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <24000000>;
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio72_default>;
				reset-gpio = <&portc 8 0>;
				eswin,camera-hdr-mode = <0>;
				power-domains = <&d0_pmu 2>;
				status = "okay";
				port {
					imx415_out0:endpoint {
						remote-endpoint = <&mipidphy0_in_ucam0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <360000000>;
					};
				};
			};
		};
	};

	fragment@5 {
		target =  <&d0_i2c2>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx415_1:imx415_1@37 {
				compatible = "sony,imx415";
				reg = <0x37>;
				clock-names="inck";
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <24000000>;
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio78_default>;
				reset-gpio = <&portc 14 0>;
				eswin,camera-hdr-mode = <0>;
				power-domains = <&d0_pmu 2>;
				status = "okay";
				port {
					imx415_out1: endpoint {
						remote-endpoint = <&mipidphy2_in_ucam0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <360000000>;
					};
				};
			};
		};
	};

	fragment@6 {
		target = <&mipi_csi2_0>;
		__overlay__ {
			num_lanes = <2>;
			eswin,csi-hdr-mode = <0>;
		};
	};

	fragment@7 {
		target = <&mipi_csi2_2>;
		__overlay__ {
			num_lanes = <2>;
			eswin,csi-hdr-mode = <0>;
		};
	};

	fragment@8 {
		target = <&dvp2axi_mipi_lvds0>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@9 {
		target = <&dvp2axi_mipi_lvds1>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@10 {
		target = <&dvp2axi_mipi_lvds2>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@11 {
		target = <&dvp2axi_mipi_lvds3>;
		__overlay__ {
			eswin,dvp2axi-hdr-mode = <0>;
		};
	};

	fragment@12 {
		target = <&imx219_0>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@13 {
		target = <&imx219_1>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@14 {
		target = <&csi2_dphy_hw0>;
		__overlay__ {
			lanes = <1 2>;
			lanes-dp-dn = <0 0>;
		};
	};

	fragment@15 {
		target = <&csi2_dphy_hw2>;
		__overlay__ {
			lanes = <1 2>;
			lanes-dp-dn = <0 0>;
		};
	};

	fragment@16 {
		target = <&vi_subsys>;
		__overlay__ {
			phy_mode = <5>;
		};
	};

};
