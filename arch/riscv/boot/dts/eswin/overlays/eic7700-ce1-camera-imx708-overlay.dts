/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target = <&vi_subsys>;
		__overlay__ {
			phy_mode = <5>;
		};
	};

	fragment@1 {
		target = <&mipi_csi2_0>;
		__overlay__ {
			num_lanes = <2>;
		};
	};

	fragment@2 {
		target = <&mipi_csi2_2>;
		__overlay__ {
			num_lanes = <2>;
		};
	};

	fragment@3 {
		target = <&mipi_csi2_4>;
		__overlay__ {
			num_lanes = <2>;
		};
	};

	fragment@4 {
		target = <&mipidphy0_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx708_out0>;
			data-lanes = <1 2>;
		};
	};

	fragment@5 {
		target = <&mipidphy2_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx708_out1>;
			data-lanes = <1 2>;
		};
	};

	fragment@6 {
		target = <&mipidphy4_in_ucam0>;
		__overlay__ {
			remote-endpoint = <&imx708_out2>;
			data-lanes = <1 2>;
		};
	};

	fragment@7 {
		target = <&csi2_dphy_hw0>;
		__overlay__ {
			lanes = <1 2>;
			lanes-dp-dn = <0 0>;
		};
	};

	fragment@8 {
		target = <&csi2_dphy_hw2>;
		__overlay__ {
			lanes = <1 2>;
			lanes-dp-dn = <0 0>;
		};
	};

	fragment@9 {
		target = <&csi2_dphy_hw4>;
		__overlay__ {
			lanes = <1 2>;
			lanes-dp-dn = <0 0>;
		};
	};

	fragment@10 {
		target = <&csi2_dphy0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@11 {
		target = <&csi2_dphy2>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@12 {
		target = <&csi2_dphy4>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@13 {
		target = <&d0_i2c3>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx708_0: imx708_0@1a {
				compatible = "sony,imx708";
				status = "okay";
				address-cells = <1>;
				size-cells = <0>;
				reg = <0x1a>;
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <24000000>;
				clock-names = "inclk";
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio71_default>;
				reset-gpio = <&portc 7 0>;
				power-domains = <&d0_pmu 2>;

				port {
					imx708_out0: endpoint {
						remote-endpoint = <&mipidphy0_in_ucam0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <450000000>;
					};
				};
			};
		};
	};

	fragment@14 {
		target = <&d0_i2c4>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx708_1: imx708_1@1a {
				compatible = "sony,imx708";
				status = "okay";
				address-cells = <1>;
				size-cells = <0>;
				reg = <0x1a>;
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <24000000>;
				clock-names = "inclk";
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio77_default>;
				reset-gpio = <&portc 13 0>;
				power-domains = <&d0_pmu 2>;

				port {
					imx708_out1: endpoint {
						remote-endpoint = <&mipidphy2_in_ucam0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <450000000>;
					};
				};
			};
		};
	};

	fragment@15 {
		target = <&d0_i2c5>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			imx708_2: imx708_2@1a {
				compatible = "sony,imx708";
				status = "okay";
				address-cells = <1>;
				size-cells = <0>;
				reg = <0x1a>;
				clocks = <&d0_clock 0x244>;
				assigned-clocks = <&d0_clock 0x244>;
				assigned-clock-rates = <24000000>;
				clock-names = "inclk";
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio83_default>;
				reset-gpio = <&portc 19 0>;
				power-domains = <&d0_pmu 2>;

				port {
					imx708_out2: endpoint {
						remote-endpoint = <&mipidphy4_in_ucam0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <450000000>;
					};
				};
			};
		};
	};

	fragment@18 {
		target = <&imx219_0>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@19 {
		target = <&imx219_1>;
		__overlay__ {
			status="disabled";
		};
	};

	fragment@20 {
		target = <&imx219_2>;
		__overlay__ {
			status="disabled";
		};
	};
};