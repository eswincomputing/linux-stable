		clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_3>;
		assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_3>;
		assigned-clock-rates = <24000000>;
		clock-frequency = <24000000>;
		clock-names = "xvclk";
		power-domains = <&d0_pmu EIC770X_PD_VI>;

		port {
			ov2718_out3: endpoint {
				remote-endpoint = <&mipidphy3_in_ucam0>;
