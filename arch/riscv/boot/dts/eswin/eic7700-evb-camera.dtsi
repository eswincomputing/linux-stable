	ipi2_vcid          = <1>;      /* data mapped to VC1 */
	ipi3_en            = <0>;
	ipi3_vcid          = <2>;      /* data mapped to VC2 */
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_5_input: endpoint@0 {
				remote-endpoint = <&csidphy5_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_5_output0: endpoint@1 {
				remote-endpoint = <&axi2dvp_mipi2_in5>;
			};
		};
	};
};

