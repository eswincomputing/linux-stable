// #include "eswin-win2030-die0-soc.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
&vi_subsys {
	eswin,isp_dvp0_hor = <1920>;
	eswin,isp_dvp0_ver = <1080>;
	/* imx327 4lane HDR mode */
	phy_mode = <5>; //5: 6x2lanes, 2: 3x4lanes
	isp_connect_mode = <0>;
	// imx327,wdr-en-2;

	vvcam_vb: vvcam_vb@0 {
		compatible = "verisilicon,vb";
		status = "okay";
		#size-cells = <2>;
		dma-noncoherent;
		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
		iommus = <&smmu0 WIN2030_SID_ISP0>;
	};

	vvcam_video_0: vvcam_video@0 {
		compatible = "verisilicon,video";
		id = <0>;
		status = "okay";
		#size-cells = <2>;
		dma-noncoherent;
		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
		iommus = <&smmu0 WIN2030_SID_ISP0>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				vvcam_video0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port0_mp>;
				};
			};

			port@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				vvcam_video1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port0_sp1>;
				};
			};

			port@2 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <2>;
				vvcam_video2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port0_sp2>;
				};
			};

			port@3 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <3>;
				vvcam_video3: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port0_raw>;
				};
			};

			port@4 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <4>;
				vvcam_video4: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port1_mp>;
				};
			};

			port@5 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <5>;
				vvcam_video5: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port1_sp1>;
				};
			};

			port@6 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <6>;
				vvcam_video6: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port1_sp2>;
				};
			};

			port@7 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <7>;
				vvcam_video7: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port1_raw>;
				};
			};
		};
	};

	vvcam_video_1: vvcam_video@1 {
		compatible = "verisilicon,video";
		id = <1>;
		status = "okay";
		#size-cells = <2>;
		dma-noncoherent;
		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
		iommus = <&smmu0 WIN2030_SID_ISP1>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				vvcam1_video0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port0_mp>;
				};
			};

			port@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				vvcam1_video1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port0_sp1>;
				};
			};

			port@2 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <2>;
				vvcam1_video2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port0_sp2>;
				};
			};

			port@3 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <3>;
				vvcam1_video3: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port0_raw>;
				};
			};
		};
	};
};

&d0_i2c3 {
	/* mipi csi0/csi1 */
	status = "okay";
	imx327_0: imx327@36 {
		compatible = "sony,imx327lqr";
		status = "okay";
		address-cells = <1>;
		size-cells = <0>;
		reg = <0x36>;
		clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
		assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
		assigned-clock-rates = <37125000>;
		clock-frequency = <37125000>;
		clock-names = "xclk";
		power-domains = <&d0_pmu EIC770X_PD_VI>;

		port {
			imx327_out0: endpoint {
				remote-endpoint = <&mipidphy0_in_ucam0>;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <445500000 297000000>;
			};
		};
	};

	ov2718_1: ov2718@10 {
		compatible = "ovti,ov2718";
		status = "okay";
		address-cells = <1>;
		size-cells = <0>;
		reg = <0x10>;
		clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_1>;
		assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_1>;
		assigned-clock-rates = <24000000>;
		clock-frequency = <24000000>;
		clock-names = "xvclk";
		power-domains = <&d0_pmu EIC770X_PD_VI>;

		port {
			ov2718_out1: endpoint {
				remote-endpoint = <&mipidphy1_in_ucam0>;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <480000000>;
			};
		};
	};
};

&d0_i2c4 {
	/* mipi csi2/csi3 */
	status = "okay";
	imx327_2: imx327@36 {
		compatible = "sony,imx327lqr";
