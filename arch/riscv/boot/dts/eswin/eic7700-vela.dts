#include "eic7700-som260-a1.dtsi"
#include "eic7700-vela-camera-imx415.dtsi"

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	model = "ESWIN EIC7700 VELA";

	reg_vcc1v8: vcc1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

&d0_gmac0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio80_default>;
	rst-gpios = <&portc 16 GPIO_ACTIVE_LOW>;
	phy-mode = "rgmii-txid";
	dly-param-1000m = <0x23232323 0xa0209023 0x20202020>;
	dly-param-100m = <0x50505050 0x803f8050 0x3f3f3f3f>;
	dly-param-10m = <0 0 0>;
};

&d0_gmac1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio81_default>;
	rst-gpios = <&portc 17 GPIO_ACTIVE_LOW>;
	phy-mode = "rgmii-txid";
	dly-param-1000m = <0x00000000 0xe002e000 0x04040404>;
	dly-param-100m = <0x48484848 0x80588048 0x58585858>;
	dly-param-10m = <0 0 0>;
};


&pcie {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio10_default>;
	pci-prsnt = <&porta 10 GPIO_ACTIVE_LOW>;
};

&sdio0 {
	/* sd card */
	delay_code = <0x3b>;
	drive-impedance-ohm = <33>;
	enable-cmd-pullup;
	enable-data-pullup;
	no-sdio;
	no-mmc;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio13_default>;
	cd-gpios = <&porta 13 GPIO_ACTIVE_LOW>;
};

&sdio1 {
	/* wifi module */
	delay_code = <0x32>;
	drive-impedance-ohm = <33>;
	enable-cmd-pullup;
	enable-data-pullup;
	keep-power-in-suspend;
	non-removable;
	no-sd;
	no-mmc;
	vqmmc-supply = <&reg_vcc1v8>;
	aw3155:wifi_aw3155@0 {
		compatible = "aml_w1_sdio";
		reg = <0x0>;
		interrupt-parent = <&porta>;
		interrupts = <15 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default", "default";
		pinctrl-0 = <&pinctrl_gpio15_default>;
		pinctrl-1 = <&pinctrl_gpio79_default>;
		irq-gpios = <&porta 15 GPIO_ACTIVE_HIGH>;
		rst-gpios = <&portc 15 GPIO_ACTIVE_HIGH>;

	};
	mdhd_wlan {
		compatible = "android,bcmdhd_wlan";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio79_default>;
		gpio_wl_reg_on = <&portc 15 GPIO_ACTIVE_HIGH>;
	};
};

&ssi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_dual_spi1_default>;
	num-cs = <1>;
	spi-flash@0 {
		compatible = "winbond,w25q128",
					"jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <4800000>;
		rx-sample-delay-ns = <10>;
	};
};

&ssi1 {
	/* unused */
	status = "disabled";
};

&d0_graphcard1 {
	status = "disabled";
	label = "Analog Audio-0";
};

&d0_graphcard2 {
	status = "disabled";
};

&video_output {
	status = "okay";
};

&dc {
	status = "okay";
	dc_out: port {
		#address-cells = <1>;
		#size-cells = <0>;
		dc_out_dpi: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&vd_input>;
		};
		dc_out_hdmi: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&hdmi_in_dc>;
		};
	};
};

&dw_hdmi {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			hdmi_in_dc: endpoint@0 {
				remote-endpoint = <&dc_out_hdmi>;
			};
		};
		port@2 {
			reg = <2>;
			hdmi_in_i2s: endpoint@1 {
				system-clock-frequency = <12288000>;
				remote-endpoint = <&d0_i2s0_endpoint>;
			};
		};
	};
};

&d0_i2s0 {
	status = "okay";
	d0_i2s0_port: port {
		d0_i2s0_endpoint: endpoint {
			remote-endpoint = <&hdmi_in_i2s>;
			dai-format = "i2s";
		};
	};
};

&d0_i2s1 {
	status = "disabled";
};

&d0_i2s2 {
	status = "disabled";
};

&d0_i2c0 {
	/* pin header */
	status = "okay";
	tmp102@48 {
		compatible = "ti,tmp102";
		reg = <0x48>;
		label = "board_tmp";
		#thermal-sensor-cells = <1>;
	};
};

&d0_i2c1 {
	/* rtc rs4c411 & mipi dsi */

};

&d0_i2c2 {
	status = "okay";
	pcf_rtc:rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
	};
};

&d0_aon_i2c0 {
	sys_power:ina226@40 {
		compatible = "ti,ina226";
		#io-channel-cells = <1>;
		label = "sys_power";
		reg = <0x40>;
		shunt-resistor = <1000>;
	};
};

&pinctrl {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio1_default &pinctrl_gpio2_default &pinctrl_gpio3_default &pinctrl_gpio4_default
			&pinctrl_gpio7_default &pinctrl_gpio8_default &pinctrl_gpio9_default &pinctrl_gpio10_default
			&pinctrl_gpio22_default &pinctrl_gpio30_default &pinctrl_gpio31_default &pinctrl_gpio32_default
			&pinctrl_gpio33_default &pinctrl_gpio39_default &pinctrl_gpio40_default &pinctrl_gpio41_default
			&pinctrl_gpio73_default &pinctrl_gpio74_default &pinctrl_gpio75_default>;
};

/******** pin headers *********
     pin : function
       3 : I2C0 SDA(GPIO45)
       5 : I2C0 SCL(GPIO44)
       7 : GPIO22(I2S_MCLK)
       8 : UART3 TX(GPIO92)
      10 : UART3 RX(GPIO93)
      11 : GPIO9
      12 : GPIO30(I2S1_BCLK)
      13 : GPIO1
      15 : GPIO8
      16 : GPIO10
      18 : GPIO4
      19 : SPI1 D0(GPIO37/UART4 TX)
      21 : SPI1 D1(GPIO38/UART4 RX)
      22 : GPIO3
      23 : SPI1 CLK(GPIO36)
      24 : SPI1 CS0(GPIO35)
      26 : GPIO41(SPI1 CS1)
      27 : I2C10 SDA(GPIO103)
      28 : I2C10 SCL(GPIO102)
      29 : GPIO7
      31 : GPIO73
      32 : GPIO39(SPI1 D2)
      33 : GPIO74
      35 : GPIO31(I2S1_WCLK)
      36 : GPIO40(SPI1 D3)
      37 : GPIO2
      38 : GPIO32(I2S1_SDI)
      40 : GPIO33(I2S1_SDO)
*********************************/

/* GPIO Function Description
	gpio0   : touch int(I)
	gpio5   : 5g wake on host(I)
	gpio6   : 5g disable2(O)
	gpio7   : mipi dsi ctrl(O)
	gpio8   : 5g disable1(O)
	gpio9   : rk628 plugin detect(I)
	gpio10  : pcie prsnt(I)
	gpio12  : bt wake host(I)
	gpio15  : wlan wake host(I)
	gpio26  : ap backup(I)
	gpio39  : lora busy(I)
	gpio41  : host wake bt(I)
	gpio70  : rk628 int(I)
	gpio71  : rk628 reset(O)
	gpio73  : rk628 power enable(O)
	gpio74  : 5g pwren(O)
	gpio76  : eth rset(O)
	gpio77  : lora nreset(O)
	gpio79  : m2 power on(O)
	gpio80  : lora ctrl2(O)
	gpio81  : lora ctrl1(O)
	gpio92  : touch rstn(O)
	gpio93  : 5g reset(O)
*/