	lanes = <1 2>;
	lanes-dp-dn = <0 0>; 	// 4lanes: positive on dp/ negative on dn to hs and lp mode
	status = "okay";
};
&csi2_dphy3 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipidphy3_in_ucam0: endpoint@0 {
