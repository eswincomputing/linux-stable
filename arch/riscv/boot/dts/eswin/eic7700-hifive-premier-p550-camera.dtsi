&vi_subsys {
	eswin,isp_dvp0_hor = <3280>;
	eswin,isp_dvp0_ver = <2464>;
	phy_mode = <5>; //5: 6x2lanes, 2: 3x4lanes
	isp_connect_mode = <2>;

	vvcam_vb: vvcam_vb@0 {
		compatible = "verisilicon,vb";
		status = "okay";
		#size-cells = <2>;
		dma-noncoherent;
		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
		iommus = <&smmu0 WIN2030_SID_ISP0>;
	};

    vvcam_video_0: vvcam_video@0 {
        compatible = "verisilicon,video";
        id = <0>;
        status = "okay";
		#size-cells = <2>;
		dma-noncoherent;
		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
		iommus = <&smmu0 WIN2030_SID_ISP0>;

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                vvcam_video0: endpoint {
                    remote-endpoint = <&vvcam_isp_port0_mp>;
                };
            };

            port@1 {
                reg = <1>;
                vvcam_video1: endpoint {
                    remote-endpoint = <&vvcam_isp_port0_sp1>;
                };
            };

            port@2 {
                reg = <2>;
                vvcam_video2: endpoint {
                    remote-endpoint = <&vvcam_isp_port0_sp2>;
                };
            };

            port@3 {
                reg = <3>;
                vvcam_video3: endpoint {
                    remote-endpoint = <&vvcam_isp_port0_raw>;
                };
            };
			port@4 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <4>;
				vvcam_video4: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port1_mp>;
				};
			};

			port@5 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <5>;
				vvcam_video5: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port1_sp1>;
				};
			};

			port@6 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <6>;
				vvcam_video6: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port1_sp2>;
				};
			};

			port@7 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <7>;
				vvcam_video7: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_port1_raw>;
				};
			};
        };
    };

	vvcam_video_1: vvcam_video@1 {
		compatible = "verisilicon,video";
		id = <1>;
		status = "okay";
		#size-cells = <2>;
		dma-noncoherent;
		dma-ranges = <0x0 0x20000000 0x0 0x80000000 0x0 0x40000000>;
		iommus = <&smmu0 WIN2030_SID_ISP1>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				vvcam1_video0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port0_mp>;
				};
			};

			port@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				vvcam1_video1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port0_sp1>;
				};
			};

			port@2 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <2>;
				vvcam1_video2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port0_sp2>;
				};
			};

			port@3 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <3>;
				vvcam1_video3: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port0_raw>;
				};
			};
			port@4 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <4>;
				vvcam1_video4: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port1_mp>;
				};
			};

			port@5 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <5>;
				vvcam1_video5: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port1_sp1>;
				};
			};

			port@6 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <6>;
				vvcam1_video6: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port1_sp2>;
				};
			};

			port@7 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <7>;
				vvcam1_video7: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vvcam_isp_1_port1_raw>;
				};
			};
		};
	};
};

&d0_i2c5 {
	status = "okay";
	/* i2c-sda-hold-time-ns = <1000>; */
	/* clock-frequency = <0x186a0>; */

	pca9548:i2c-mux@70 {
		/*compatible = "ti,tca9548"; */
		compatible = "nxp,pca9548";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x70>;

		i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0>;

			imx219_0: imx219_0@10 {
				status = "okay";
				compatible = "sony,imx219";
				reg = <0x10>;

				clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
				assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
				assigned-clock-rates = <24000000>;
				clock-names = "xvclk";
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio72_default>;
				reset-gpio = <&portc 8 GPIO_ACTIVE_HIGH>;
				power-domains = <&d0_pmu EIC770X_PD_VI>;

				port {
					imx219_out0: endpoint {
						remote-endpoint = <&mipidphy0_in_ucam0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
					};
				};
			};
		};

		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x1>;

			imx219_1: imx219_1@10 {
				status = "okay";
				compatible = "sony,imx219";
				reg = <0x10>;

				clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
				assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
				assigned-clock-rates = <24000000>;
				clock-names = "xvclk";
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio75_default>;
				reset-gpio = <&portc 11 GPIO_ACTIVE_HIGH>;
				power-domains = <&d0_pmu EIC770X_PD_VI>;

				port {
					imx219_out1: endpoint {
						remote-endpoint = <&mipidphy1_in_ucam0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
					};
				};
			};
		};

		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x2>;

			imx219_2: imx219_2@10 {
				status = "okay";
				compatible = "sony,imx219";
				reg = <0x10>;

				clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
				assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
				assigned-clock-rates = <24000000>;
				clock-names = "xvclk";
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio78_default>;
				reset-gpio = <&portc 14 GPIO_ACTIVE_HIGH>;
				power-domains = <&d0_pmu EIC770X_PD_VI>;

				port {
					imx219_out2: endpoint {
						remote-endpoint = <&mipidphy2_in_ucam0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
					};
				};
			};
		};

		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x3>;

			imx219_3: imx219_3@10 {
				status = "okay";
				compatible = "sony,imx219";
				reg = <0x10>;

				clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
				assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
				assigned-clock-rates = <24000000>;
				clock-names = "xvclk";
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_gpio81_default>;
				reset-gpio = <&portc 17 GPIO_ACTIVE_HIGH>;
				power-domains = <&d0_pmu EIC770X_PD_VI>;

				port {
					imx219_out3: endpoint {
						remote-endpoint = <&mipidphy3_in_ucam0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
					};
				};
			};
		};
	};
};

&csi2_dphy_hw0 {
	lanes = <1 2>;
	lanes-dp-dn = <0 0>; 	// 4lanes: positive on dp/ negative on dn to hs and lp mode
	status = "okay";
};

&csi2_dphy0 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipidphy0_in_ucam0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&imx219_out0>;
				data-lanes = <1 2>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy0_out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&mipi_csi2_0_input>;
			};
		};
	};
};

&csi2_dphy_hw1 {
	lanes = <1 2>;
	lanes-dp-dn = <0 0>; 	// 4lanes: positive on dp/ negative on dn to hs and lp mode
	status = "okay";
};

