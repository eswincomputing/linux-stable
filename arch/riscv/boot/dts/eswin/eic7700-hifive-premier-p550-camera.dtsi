			};
		};

		port@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;
			vvcam_isp_1_port0_sp1: endpoint {
				remote-endpoint = <&vvcam1_video1>;
			};
		};

		port@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
			vvcam_isp_1_port0_sp2: endpoint {
				remote-endpoint = <&vvcam1_video2>;
			};
		};

		port@4 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <4>;
			vvcam_isp_1_port0_raw: endpoint {
				remote-endpoint = <&vvcam1_video3>;
			};
		};
		port@5 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <5>;
			vvcam_isp_1_input_port1: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi_csi2_3_output1>;
			};
		};

		port@6 {
			#address-cells = <1>;
