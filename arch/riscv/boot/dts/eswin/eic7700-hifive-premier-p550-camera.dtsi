};

&dvp2axi {
	status = "okay";
};

&dvp2axi_mipi_lvds0 {
	status = "okay";
	dvp2axi_id = <0>;
	port@0 {
		axi2dvp_mipi2_in0: endpoint@0 {
			remote-endpoint = <&mipi_csi2_0_output0>;
		};
	};
};

