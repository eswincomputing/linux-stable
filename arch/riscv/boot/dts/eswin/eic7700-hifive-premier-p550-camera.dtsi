				remote-endpoint = <&mipi_csi2_3_input>;
			};
		};
	};
};

&mipi_csi2_0 {
	num_lanes = <2>;
	snps,en-ppi-width = <1>; // 1: 16-bit, 0: 8-bit
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_0_input: endpoint@0 {
				remote-endpoint = <&csidphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_0_output0: endpoint@1 {
				remote-endpoint = <&axi2dvp_mipi2_in0>;
			};
		};

		port@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_0_output1: endpoint {
				remote-endpoint = <&vvcam_isp_input_port0>;
			};
		};
	};
};

