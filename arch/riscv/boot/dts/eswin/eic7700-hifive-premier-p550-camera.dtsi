&vvcam_isp_0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
			vvcam_isp_input_port0: endpoint@0 {
				remote-endpoint = <&mipi_csi2_0_output1>;
			};
		};

		port@1 {
			reg = <1>;
			vvcam_isp_port0_mp: endpoint {
				remote-endpoint = <&vvcam_video0>;
			};
		};

		port@2 {
			reg = <2>;
			vvcam_isp_port0_sp1: endpoint {
				remote-endpoint = <&vvcam_video1>;
			};
		};

		port@3 {
			reg = <3>;
			vvcam_isp_port0_sp2: endpoint {
				remote-endpoint = <&vvcam_video2>;
			};
		};

		port@4 {
			reg = <4>;
			vvcam_isp_port0_raw: endpoint {
				remote-endpoint = <&vvcam_video3>;
			};
		};

		port@5 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <5>;
			vvcam_isp_input_port1: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi_csi2_1_output1>;
			};
		};

		port@6 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <6>;
			vvcam_isp_port1_mp: endpoint {
				remote-endpoint = <&vvcam_video4>;
			};
		};

		port@7 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <7>;
			vvcam_isp_port1_sp1: endpoint {
				remote-endpoint = <&vvcam_video5>;
			};
		};

		port@8 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <8>;
			vvcam_isp_port1_sp2: endpoint {
				remote-endpoint = <&vvcam_video6>;
			};
		};

		port@9 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <9>;
			vvcam_isp_port1_raw: endpoint {
				remote-endpoint = <&vvcam_video7>;
			};
		};
	};
};

&vvcam_isp_1 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
			vvcam_isp_1_input_port0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi_csi2_2_output1>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
			vvcam_isp_1_port0_mp: endpoint {
