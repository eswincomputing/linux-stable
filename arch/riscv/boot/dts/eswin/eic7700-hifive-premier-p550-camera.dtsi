	};
};

&csi2_dphy_hw2 {
	lanes = <1 2>;
	lanes-dp-dn = <0 0>; 	// 4lanes: positive on dp/ negative on dn to hs and lp mode
	status = "okay";
};
&csi2_dphy2 {
	status = "okay";
	ports {
		#address-cells = <1>;
