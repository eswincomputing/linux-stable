&die0_rtc {
	status = "okay";
};

&pinctrl {
	status = "okay";

	pinctrl_gpio58_default: gpio58-default {
		mux {
			groups = "gpio58_group";
			function = "gpio58_func";
		};
		conf {
			groups = "gpio58_group";
			input-enable = <1>;
			bias-pull-down = <0>;
		};
	};

	pinctrl_gpio59_default: gpio59-default {
		mux {
			groups = "gpio59_group";
			function = "gpio59_func";
		};
		conf {
			groups = "gpio59_group";
			input-enable = <1>;
			bias-pull-down = <0>;
		};
	};

	pinctrl_gpio60_default: gpio60-default {
		mux {
			groups = "gpio60_group";
			function = "gpio60_func";
		};
		conf {
			groups = "gpio60_group";
			input-enable = <1>;
			bias-pull-down = <0>;
		};
	};

	pinctrl_gpio61_default: gpio61-default {
		mux {
			groups = "gpio61_group";
			function = "gpio61_func";
		};
		conf {
			groups = "gpio61_group";
			input-enable = <1>;
			bias-pull-down = <0>;
		};
	};
};

/* GPIO Function Description

	gpio0   : pcie prstn(I)
	gpio5   : led back light power on/off(O)
	gpio6   : system key(I)
	gpio10  : dsi touch interrupt(I)
	gpio11  : head phone plug/unplug detection2(I)
	gpio12  : tf card power on/off(O)
	gpio14  : bt wake host(I)
	gpio15  : wlan wake host(I)
	gpio16  : gphy1 resetn(O)
	gpio28  : head phone plug/unplug detection1(I)
	gpio34  : m.2 power on/off(O)
	gpio94  : gphy0 resetn(O)
	gpio106 : touch reset(O)
	gpio107 : system led0(O)
	gpio108 : system led1(O)
	gpio109 : system led2(O)
	gpio110 : system led3(O)
	gpio111 : mipi dsi resetn(O)
*/

&gpio0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio58_default
	&pinctrl_gpio59_default
	&pinctrl_gpio60_default
	&pinctrl_gpio61_default>;
};

&d0_dev_llc {
	npu-supply = <&npu_vcc>;
	status = "okay";
};
