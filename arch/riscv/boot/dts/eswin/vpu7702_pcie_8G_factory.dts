	status = "disabled";
};

&d0_i2c0 {
	/* 12V_DC_IN */
	status = "disabled";
	i2c-sda-hold-time-ns = <0x40>;
	ina226@44 {
		compatible = "ti,ina226";
		#io-channel-cells = <1>;
		label = "soc_vdd";
		reg = <0x44>;
		shunt-resistor = <1000>;
	};
};

&d0_i2c1 {
	/* NPU Power Control */
	status = "okay";
	tps549d22@10 {
		compatible = "ti,tps549d22";
		reg = <0x10>;
		eswin,regulator_default-microvolt=<1000000>;
		eswin,regulator_label = "Supply VDD", "NPU Voltage";
		label = "npu_vdd";
		regulators{
			npu_vcc:npu_svcc{
				regulator-name="NPU_SVCC";
				regulator-min-microvolt=<700000>;
				regulator-max-microvolt=<1120000>;
				regulator-min-microamp=<20000000>;
				regulator-max-microamp=<40000000>;
				regulator-ov-protection-microvolt=<1100000>;
			};
		};
	};
};

&d0_i2c2 {
	/* Temperature Sensor */
	status = "disabled";
	tmp102@48 {
		compatible = "ti,tmp102";
		reg = <0x48>;
		label = "d0_board_tmp";
		#thermal-sensor-cells = <1>;
	};
};

&d0_i2c3 {
	/* Die 2 Die Serdes */
	status = "disabled";
};

&d0_i2c4 {
	/* ADC */
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c10_default>;
	status = "disabled";

	adc@48 {
		compatible = "ti,ads1115";
		reg = <0x48>;
		#address-cells = <1>;
		#size-cells = <0>;

		channel@4 {
			reg = <4>;
			ti,gain = <0>;
			ti,datarate = <7>;
		};

		channel@5 {
			reg = <5>;
			ti,gain = <0>;
			ti,datarate = <7>;
		};

		channel@6 {
			reg = <6>;
			ti,gain = <0>;
			ti,datarate = <7>;
		};

		channel@7 {
			reg = <7>;
			ti,gain = <0>;
			ti,datarate = <7>;
		};
	};
};

&d0_i2c5 {
	/* AT24C02C EEPROM */
	status = "disabled";
	eswin,syscfg = <&d0_sys_con 0x3C0 16>;
	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
	};
};

&d0_i2c6 {
	/* unused */
	status = "disabled";
};

&d0_i2c7 {
	/* unused */
	status = "disabled";
};

&d0_i2c8 {
