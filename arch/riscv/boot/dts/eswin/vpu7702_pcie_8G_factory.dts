/dts-v1/;

#define RTCCLK_FREQ		1000000
#define LSPCLK_FREQ		200000000

/* If wanna enable ECC capability of DDR, should reserve highest zone of 1/8 all space for it */
#define MEMORY_SIZE_H		0x1
#define MEMORY_SIZE_L		0xc0000000
#define CMA_SIZE		0x20000000

#include "eswin-win2030-die0-soc.dtsi"
#include "eic7700-pinctrl.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/* Clock frequency (in Hz) of the PCB crystal for rtcclk */

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	model = "ESWIN EIC7702 VPU FACTORY 8G";
	compatible = "eswin,eic7x";

	aliases {
		serial0 = &d0_uart0;
		rtc0 = &die0_rtc;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		opensbi_domain_config: domain-config {
			compatible = "opensbi,domain,config";
			system-suspend-test;
		};
	};

	cpus {
		timebase-frequency = <RTCCLK_FREQ>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 MEMORY_SIZE_H MEMORY_SIZE_L>;
		numa-node-id = <0>;
	};

	memory@59000000 {
		device_type = "memory";
		reg = <0x0 0x59000000 0x0 0x400000>;
		numa-node-id = <0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 CMA_SIZE>;
			alignment = <0x0 0x1000>;
			alloc-ranges = <0x0 0x80000000 MEMORY_SIZE_H MEMORY_SIZE_L>;
			linux,cma-default;
		};

		npu0_reserved: sprammemory@59000000 {
			no-map;
			reg = <0x0 0x59000000 0x0 0x400000>;
		};

		ramoops@fff00000 {
			compatible = "ramoops";
			reg = <0x0 0xfff00000 0x0 0x100000>;
			console-size = <0x40000>;
			record-size = <0x40000>;
			ftrace-size = <0x40000>;
			pmsg-size = <0x40000>;
			no-map;
		};

		mmz_nid_0_part_0 {
			compatible = "eswin-reserve-memory";
			reg = <0x1 0x40000000 0x0 0x40000000>;
			no-map;
		};

		pci_phys_mem_0 {
			compatible = "eswin-reserve-memory";
			reg = <0x80 0x0 0x20 0x0>;
			no-map;
		};

		rpc_reserved:rpc_reserved@100000000 {
			reg = <0x1 0x0 0 0x1000>;
			no-map;
		};

		commu_reserved:commu_reserved@100001000 {
			reg = <0x1 0x1000 0 0x10000>;
			no-map;
		};

		kernel_debug_reserved:kernel_debug_reserved@100011000 {
			reg = <0x1 0x11000 0 0x100000>;
			no-map;
		};

		pgretire_reserved:pgretire_reserved@100111000 {
			reg = <0x1 0x111000 0 0x100000>;
			no-map;
		};

		configs_reserved:configs_reserved@100211000 {
			reg = <0x1 0x211000 0 0x1000>;
			no-map;
		};

		ipcm_vdev0vring0:vdev0vring0@100212000 {
			reg = <0x1 0x212000 0 0x100000>;
			no-map;
		};

		ipcm_vdev0vring1:vdev0vring1@100312000 {
			reg = <0x1 0x312000 0 0x100000>;
			no-map;
		};

		ipcm_vdev0buffer:vdev0buffer@100412000 {
			compatible = "shared-dma-pool";
			reg = <0x1 0x412000 0 0x4000000>; // pre is rx
			no-map;
		};

		rsc_table0:rsc_table0@104412000 {
			reg = <0x1 0x4412000 0 0x1000>;
			no-map;
		};

		version_table:version_table@104413000 {
			reg = <0x1 0x4413000 0 0x1000>;
			no-map;
		};

		bd_table:bd_table@104414000 {
			reg = <0x1 0x4414000 0 0x1000>;
			no-map;
		};

		usage_table:usage_table@104415000 {
			reg = <0x1 0x4415000 0 0x1000>;
			no-map;
		};

		share_memory {
			compatible = "eswin,shm";
			#address-cells = <2>;
			#size-cells = <2>;
			phys-base = <0x1 0x4416000>;
			virt-base = <0x1 0x4416000>;
			shm-size = <0xb7ea000>;
			reg = <0x1 0x4416000 0 0xb7ea000>;
		};

		pci_phys_mem_1 {
			compatible = "eswin-reserve-memory";
			reg = <0x1 0xFC00000 0 0x400000>;
			no-map;
		};
	};

	soc {
		d0_ipcm:ipcm@0 {
			compatible = "eswin,ipcm", "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			vf_id = <0>;
			numa-node-id = <0>;
			memory-region = <&ipcm_vdev0vring0>,<&ipcm_vdev0vring1>,<&ipcm_vdev0buffer>;
			interrupt-parent = <&plic0>;
			interrupts = <123>;
		  	smmu_dev = <&smmu_cfg_0>;
		};

		dev_smmu_cfg: smmu_cfg@0 {
			compatible = "eswin,vpu7702_dev_smmu_cfg";
			#size-cells = <2>;
			dma-ranges = <0x0 0x20000000 0x0 0xc0000000 0x0 0xc0000000>;
			iommus = <&smmu0 WIN2030_SID_DEV_FOO_B>;
			iommu-map = <0x000000 &smmu0 0xff0000 0xffffff>;
			tbus = <WIN2030_TBUID_PCIE>;
			status = "okay";
			numa-node-id = <0>;
			dma-noncoherent;
                        #include "smmu_cfg.dtsi"

		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio68_default>;
		gpio-68 {
			label = "heartbeat";
			gpios = <&portc 4 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};
	};
};

&d0_trip_threshold {
	temperature = <60000>;
};
&d0_trip_target {
	temperature = <70000>;
};
&d0_trip_crit {
	temperature = <80000>;
};

&d0_clock {
	status = "okay";
};

&d0_reset {
	status = "okay";
};

&d0_pmu {
	status = "okay";
	npu-supply = <&npu_vcc>;
	d0_pmu_pcie: win2030-pmu-controller-port@0 {
		power_status = <2>;
	};
};

